<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#123147" />
  <title>記憶光房 | 失智友善照護密室逃脫</title>
  <style>
    :root { --ink:#19354a; --muted:#5b7080; --navy:#123147; --teal:#127f83; --mint:#d9f1e9; --coral:#ec9374; --cream:#fffaf1; --stroke:#d6e2e5; --shadow:0 18px 50px rgba(17,46,67,.13); }
    * {box-sizing:border-box}
    html { scroll-behavior:smooth; }
    body { margin:0; min-height:100vh; background:#f2f7f7; color:var(--ink); font-family:system-ui,-apple-system,"Noto Sans TC","Microsoft JhengHei",sans-serif; line-height:1.55; }
    button,input {font:inherit}
    button {cursor:pointer}
    button:focus-visible, input:focus-visible, a:focus-visible {outline:3px solid #e5a85c;outline-offset:3px}
    .page {max-width:1220px;margin:0 auto;padding:27px 27px 42px}
    header {display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}
    .brand {display:flex;align-items:center;gap:12px}
    .mark {width:48px;height:48px;border-radius:16px;background:var(--navy);display:grid;place-items:center;color:#e6dba7;box-shadow:0 6px 18px rgba(18,49,71,.16)}
    .mark svg {width:29px;height:29px}
    .brand strong {font-size:20px;letter-spacing:.05em;display:block}
    .brand span {font-size:12px;color:var(--muted);letter-spacing:.05em}
    .head-actions {display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .pill {display:inline-flex;align-items:center;gap:6px;border:1px solid var(--stroke);background:white;padding:8px 13px;border-radius:999px;font-size:13px;font-weight:650}
    .simple-button {padding:8px 12px;border:1px solid var(--stroke);border-radius:12px;background:white;color:var(--ink);font-weight:650}
    .simple-button:hover {background:#e9f4f3}
    .introline {display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin:18px 0 21px}
    .introline h1 {font-size:clamp(28px,3.4vw,43px);line-height:1.22;letter-spacing:.01em;margin:8px 0}
    .introline p {margin:0;color:var(--muted);font-size:15px;max-width:670px}
    .small-title {font-size:11px;color:#0c7579;letter-spacing:.18em;font-weight:850;text-transform:uppercase}
    .mission-tag {background:#e5f1ef;color:#23656a;padding:9px 13px;border-radius:12px;font-size:13px;min-width:145px;text-align:center;font-weight:750;white-space:nowrap}
    .layout {display:grid;grid-template-columns:minmax(0,1fr) 295px;gap:22px;align-items:start}
    .room-shell {background:white;border:1px solid #e1e9eb;border-radius:26px;overflow:hidden;box-shadow:var(--shadow)}
    .room-top {display:flex;justify-content:space-between;align-items:center;padding:16px 19px 13px;gap:9px}
    .room-top strong {font-size:14px}
    .room-top span {font-size:12px;color:var(--muted)}
    .room {isolation:isolate;position:relative;height:475px;overflow:hidden;background:linear-gradient(to bottom,#d1e5e5 0%,#eaf4ef 60%,#c4ddc7 60%,#e7ebd9 100%)}
    .room:before {content:"";position:absolute;inset:0 0 38% 0;background:repeating-linear-gradient(90deg,transparent 0,transparent 123px,rgba(38,103,107,.08) 124px,transparent 125px);pointer-events:none}
    .room:after {content:"";position:absolute;bottom:0;left:0;width:100%;height:40%;background:linear-gradient(115deg,rgba(255,255,255,.34),rgba(205,183,129,.07)),repeating-linear-gradient(0deg,transparent 0,transparent 44px,rgba(40,94,72,.07) 45px);pointer-events:none}
    .walltrim {position:absolute;top:60%;width:100%;height:8px;background:#b9d1c8;box-shadow:0 2px 5px #95b4a477;z-index:1}
    .window {position:absolute;top:15%;left:10%;width:25%;height:33%;border:11px solid #e1eee8;background:linear-gradient(#91d4e5 0%,#e8f5d8 67%,#abd9a5 68%,#72ac9d 100%);box-shadow:0 4px 2px #6d968e46,inset 0 0 0 2px #a4c7be;border-radius:5px;z-index:2}
    .window:before {content:"";position:absolute;left:47%;height:100%;width:7px;background:#e1eee8}
    .window:after {content:"";position:absolute;top:52%;height:7px;width:100%;background:#e1eee8}
    .window-sun {position:absolute;top:14%;left:16%;width:34px;height:34px;background:#fff4b3;border-radius:50%;filter:blur(2px)}
    .shelf {position:absolute;top:37%;left:45%;width:20%;height:25%;border:9px solid #b58762;border-top-width:10px;border-bottom-width:11px;background:#e4d5bd;z-index:2;border-radius:3px;box-shadow:4px 5px 4px #5f807944}
    .shelf:before {content:"";position:absolute;top:52%;height:9px;left:0;right:0;background:#b58762}
    .books {position:absolute;top:9%;left:10%;font-size:34px;white-space:nowrap}
    .books2 {position:absolute;top:59%;left:17%;font-size:27px}
    .chair {position:absolute;bottom:22%;left:12%;width:25%;height:28%;z-index:3}
    .chair .back {position:absolute;top:0;left:9%;width:82%;height:66%;border-radius:31px 31px 9px 9px;background:#e7a68a;border:8px solid #c77f6d;box-shadow:inset 0 10px 0 #f4c2a9}
    .chair .seat {position:absolute;bottom:13%;left:0;width:100%;height:37%;background:#cb806a;border-radius:24px 24px 13px 13px}
    .chair .feet {position:absolute;bottom:0;left:8%;width:84%;height:18%;border-left:10px solid #815d4b;border-right:10px solid #815d4b}
    .table {position:absolute;bottom:10%;left:38%;width:22%;height:21%;z-index:4}
    .table:before {content:"";position:absolute;top:10%;left:0;width:100%;height:29%;background:#b68a5d;border-radius:50% / 45%;border-bottom:8px solid #977250;box-shadow:0 8px 9px #697e6847}
    .table:after {content:"";position:absolute;top:36%;left:43%;width:14%;height:65%;background:#917251;border-radius:2px;box-shadow:0 5px 0 12px #977250}
    .cup {position:absolute;top:-12%;left:40%;font-size:31px;z-index:1}
    .plant {position:absolute;bottom:19%;right:25%;font-size:67px;filter:drop-shadow(5px 7px 3px #47715b5d);z-index:2}
    .clock {position:absolute;right:31%;top:12%;border:8px solid #b89471;width:76px;height:76px;border-radius:50%;background:#faf9e7;z-index:2;box-shadow:3px 5px 2px #9cbaad66}
    .clock:before {content:"";position:absolute;top:18%;left:48%;height:34%;width:3px;background:#4d5557;transform-origin:bottom center;transform:rotate(12deg)}
    .clock:after {content:"";position:absolute;top:49%;left:48%;height:26%;width:3px;background:#4d5557;transform-origin:top center;transform:rotate(74deg)}
    .door {position:absolute;right:5%;top:21%;height:64%;width:18%;background:linear-gradient(90deg,#adccb9,#cce6d6);border:12px solid #699d90;border-bottom:0;z-index:2;box-shadow:4px 5px 4px #486e6766}
    .door:before {content:"";position:absolute;inset:12px;border:3px solid #a1c9b6;border-radius:3px}
    .door:after {content:"";position:absolute;top:56%;left:14%;width:12px;height:12px;border-radius:50%;background:#c5925d;box-shadow:1px 1px 0 #78522a}
    .door-sign {position:absolute;top:13px;left:50%;transform:translateX(-50%);font-size:12px;font-weight:900;letter-spacing:2px;color:#3e7a6c;white-space:nowrap}
    .rug {position:absolute;bottom:1%;left:12%;width:50%;height:18%;transform:skewX(-18deg);border-radius:50%;background:rgba(237,211,171,.7);z-index:1}
    .hotspot {position:absolute;z-index:5;left:var(--left);top:var(--top);transform:translate(-50%,-50%);background:#fffef8;border:2px solid #176c73;color:#174f57;border-radius:999px;padding:9px 13px;font-weight:850;font-size:13px;white-space:nowrap;box-shadow:0 6px 0 #0d61612b,0 9px 25px #0c46404e;display:flex;align-items:center;gap:7px;transition:transform .18s,box-shadow .18s,background .18s}
    .hotspot:hover:not(:disabled) {transform:translate(-50%,-57%);box-shadow:0 10px 0 #0d61611c,0 14px 25px #0c46403e;background:#eefffa}
    .hotspot:disabled {opacity:.68;cursor:not-allowed;background:#e9eff0;border-color:#6b8e8e;color:#627d7e}
    .hotspot.done {background:#d0f4df;color:#17664a;border-color:#399975}
    .hotspot.final-spot {background:#fbe8b8;border-color:#af8644;color:#795825}
    .hotspot.final-spot:disabled {background:#f5f3e9}
    .room-footer {display:flex;justify-content:space-between;gap:10px;align-items:center;padding:15px 19px;color:var(--muted);font-size:13px;flex-wrap:wrap}
    .room-footer strong {color:var(--ink)}
    .side {display:flex;flex-direction:column;gap:15px}
    .panel {padding:21px 19px;background:white;border:1px solid var(--stroke);border-radius:22px;box-shadow:0 10px 25px rgba(20,60,72,.035)}
    .panel h2 {font-size:17px;margin:0 0 14px}
    .progressline {height:9px;background:#eaf1f0;border-radius:100px;overflow:hidden;margin:13px 0 18px}
    .progressline div {height:100%;width:0;background:linear-gradient(90deg,#339e8b,#e1b66b);transition:width .4s}
    .step {display:flex;gap:11px;align-items:center;padding:11px 0;border-bottom:1px solid #eaf0ef}
    .step:last-child {border:0;padding-bottom:0}
    .step-num {min-width:32px;width:32px;height:32px;border:1px solid #d9e6e5;border-radius:12px;display:grid;place-items:center;background:#f1f6f4;font-weight:850;color:#80949a}
    .step.done .step-num {background:#d6f4e6;border-color:#a5dfc6;color:#277458}
    .step strong {display:block;font-size:13px}
    .step small {display:block;color:var(--muted);font-size:12px}
    .step .digit {margin-left:auto;font-size:21px;font-weight:900;color:#217a78;min-width:24px;text-align:center}
    .tipbox {background:#eaf5f2;border-radius:14px;padding:13px 14px;font-size:13px;color:#376a67}
    .tipbox strong {color:#205f60}
    .hint-text {font-size:13px;color:var(--muted)}
    .meta {font-size:11px;color:#7d8e93;margin-top:17px;line-height:1.7}
    .meta a {color:#306a74;text-decoration:underline;text-underline-offset:2px}
    .shade {position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:rgba(7,26,40,.57);backdrop-filter:blur(4px);padding:18px;overflow:auto}
    .shade[hidden] {display:none}
    .dialog {width:min(680px,100%);max-height:min(91vh,900px);overflow:auto;background:#fffefa;border-radius:25px;box-shadow:0 25px 90px #0004;position:relative}
    .dialog-head {padding:26px 29px 18px;background:linear-gradient(115deg,#e5f5ef,#fdf5e7);border-bottom:1px solid #e4ebe6}
    .dialog-head .eyebrow {font-size:11px;letter-spacing:.13em;font-weight:900;color:#147e82}
    .dialog-head h2 {margin:8px 0 7px;font-size:26px;letter-spacing:.01em;line-height:1.3}
    .dialog-head p {font-size:14px;margin:0;color:var(--muted)}
    .dialog-body {padding:23px 29px 30px}
    .dialog-body h3 {margin:0 0 9px;font-size:16px}
    .dialog-body p {color:#456272;margin-top:0}
    .close {position:absolute;top:13px;right:15px;width:35px;height:35px;background:#fff8;border:1px solid #d3e3df;border-radius:50%;font-size:21px;color:#496e71;z-index:2}
    .quote {background:#eff5f2;border-left:4px solid #4d9990;padding:15px 17px;margin:0 0 17px;border-radius:0 12px 12px 0;font-size:16px;font-weight:750;color:#295759}
    .options {display:grid;gap:10px;margin:14px 0}
    .option {width:100%;border:1.5px solid #d6e6e1;background:white;padding:15px 17px;border-radius:14px;text-align:left;display:flex;align-items:flex-start;gap:12px;color:var(--ink);transition:border-color .12s,background .12s}
    .option:hover {background:#f0faf7;border-color:#7abab1}
    .option.selected {background:#dcf2eb;border-color:#238f81;box-shadow:inset 0 0 0 1px #238f81}
    .option .symbol {font-weight:850;color:#16817f;min-width:19px}
    .option small {display:block;font-size:12px;color:var(--muted);margin-top:3px}
    .grid-options {display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}
    .grid-options .option {min-height:105px}
    .feedback {margin-top:17px;background:#f1f6fa;border:1px solid #d4e6e9;border-radius:13px;padding:13px 15px;font-size:14px;color:#28515f}
    .feedback.warn {background:#fff5e6;border-color:#f0dcb5;color:#81592e}
    .feedback.success {background:#e5f5e9;border-color:#b3d9c0;color:#2b694c}
    .feedback[hidden] {display:none}
    .dialog-actions {display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-top:20px}
    .btn {border:0;border-radius:12px;background:var(--navy);color:white;padding:12px 20px;font-size:14px;font-weight:850;min-height:46px}
    .btn:hover:not(:disabled) {background:#245368}
    .btn:disabled {background:#c3d0d1;cursor:not-allowed}
    .btn.light {background:#e5f2ee;color:#145d63}
    .btn.light:hover {background:#cae9e2}
    .textbtn {border:0;background:transparent;color:#2a7479;text-decoration:underline;font-size:13px;padding:6px;text-underline-offset:3px}
    .reward {text-align:center;background:linear-gradient(125deg,#eff9ef,#f9f1db);border-radius:20px;padding:24px 15px;margin:0 0 14px;border:1px solid #dbebda}
    .reward small {display:block;color:#477575;font-weight:750}
    .reward b {font-size:74px;line-height:1.35;color:#1f7978;display:block}
    .reward p {font-size:13px;margin:5px 0;color:#5e736c}
    .codebox {display:flex;gap:9px;align-items:center;margin:14px 0 16px}
    .codebox input {width:170px;font-size:27px;letter-spacing:.44em;padding:11px 14px;text-align:center;border:2px solid #94beb9;border-radius:14px;outline-offset:4px;color:var(--navy);font-weight:850}
    .flash {animation:flash .24s ease-in-out 2}
    @keyframes flash {0%,100% {transform:translateX(0)}50% {transform:translateX(5px)}}
    .hero-illustration {height:100px;width:100px;background:#d2efe7;display:grid;place-items:center;font-size:51px;border-radius:30px;margin:0 auto 16px}
    .welcome {text-align:center}
    .welcome h3 {font-size:20px;margin:0 0 12px}
    .welcome p {margin:0 auto 18px;max-width:500px;text-align:left;font-size:15px}
    .summary {display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;text-align:center;margin:21px 0}
    .summary div {padding:14px 6px;border-radius:13px;background:#edf6f2}
    .summary b {font-size:23px;display:block;color:#217e77}
    .summary span {color:var(--muted);font-size:12px}
    .lesson {border-left:4px solid #1e8b89;background:#edf7f3;padding:12px 16px;border-radius:0 12px 12px 0;margin:14px 0;font-size:14px}
    .sources {font-size:12px;color:var(--muted);margin-top:22px;padding-top:16px;border-top:1px solid #e6eeed}
    .sources a {color:#216e76}
    .skiplink {position:absolute;top:-40px;left:10px;background:#fff;padding:10px;z-index:50}
    .skiplink:focus {top:0}
    @media(max-width:920px){.layout{grid-template-columns:1fr}.side{display:grid;grid-template-columns:1fr 1fr}.room{height:440px}.introline{align-items:flex-start}.mission-tag{display:none}}
    @media(max-width:600px){.page{padding:14px 12px 30px}.brand strong{font-size:17px}.brand span{font-size:10px}.mark{width:41px;height:41px}.pill{padding:7px 9px;font-size:12px}.head-actions{gap:5px}.head-actions .simple-button{font-size:12px;padding:7px 8px}.introline h1{font-size:30px}.introline p{font-size:13px}.room{height:390px}.room-top{padding:12px}.room-top span{display:none}.room-footer{font-size:12px}.side{grid-template-columns:1fr}.hotspot{font-size:11px;padding:7px 9px;gap:3px}.clock{width:54px;height:54px}.plant{font-size:47px}.books{font-size:22px}.books2{font-size:20px}.door{width:20%;right:3%}.dialog-head{padding:24px 21px 17px}.dialog-head h2{font-size:22px}.dialog-body{padding:20px 21px 26px}.grid-options{grid-template-columns:1fr}.grid-options .option{min-height:0}.summary{gap:6px}.summary div{padding:11px 3px}.summary b{font-size:20px}}
    @media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
  </style>
</head>
<body>
  <a class="skiplink" href="#playground">跳到遊戲區</a>
  <div class="page">
    <header>
      <div class="brand">
        <div class="mark" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="20" cy="20" r="14"/><path d="M12 23c7-12 9 8 16-4M13 14l3 2m12 10-3-2" stroke-linecap="round"/><circle cx="20" cy="20" r="2" fill="currentColor" stroke="none"/></svg></div>
        <div><strong>記憶光房</strong><span>失智友善照護 · ESCAPE ROOM</span></div>
      </div>
      <div class="head-actions"><span class="pill">⏱ <span id="timer">00:00</span></span><span class="pill" id="hint-counter">提示 0 / 3</span><button class="simple-button" id="restart">重新開始</button></div>
    </header>
    <section class="introline" aria-label="遊戲說明">
      <div><div class="small-title">一場關於理解與陪伴的解謎任務</div><h1>解開線索，點亮失智友善的一天。</h1><p>你來到一間模擬照護教室。探索三個物件，做出更有同理心的照護選擇，收集三位數密碼，打開象徵「友善照護」的出口。</p></div>
      <div class="mission-tag">3 道謎題 · 約 8–12 分鐘</div>
    </section>
    <main id="playground" class="layout">
      <section class="room-shell" aria-label="可互動的房間場景">
        <div class="room-top"><strong>01 / 友善照護模擬室</strong><span>點擊場景中的物件開始解謎</span></div>
        <div class="room">
          <div class="walltrim"></div><div class="window"><div class="window-sun"></div></div><div class="shelf"><div class="books" aria-hidden="true">📚</div><div class="books2" aria-hidden="true">🖼️</div></div>
          <div class="chair"><div class="back"></div><div class="seat"></div><div class="feet"></div></div><div class="table"><div class="cup" aria-hidden="true">☕</div></div><div class="plant" aria-hidden="true">🪴</div><div class="clock"></div><div class="door"><div class="door-sign">EXIT</div></div><div class="rug"></div>
          <button id="spot1" class="hotspot" data-open="1" style="--left:25%;--top:57%" aria-label="打開第一關：對話卡片">💬 對話卡片</button>
          <button id="spot2" class="hotspot" data-open="2" style="--left:53%;--top:56%" aria-label="打開第二關：環境清單" disabled>⌑ 環境清單 🔒</button>
          <button id="spot3" class="hotspot" data-open="3" style="--left:70%;--top:15%" aria-label="打開第三關：黃昏時刻" disabled>◷ 黃昏時刻 🔒</button>
          <button id="spot4" class="hotspot final-spot" data-open="4" style="--left:88%;--top:73%" aria-label="開啟友善出口" disabled>🔑 友善出口</button>
        </div>
        <div class="room-footer"><span><strong>探索提醒：</strong>從左側「對話卡片」開始，關卡依序開啟。</span><span id="room-status" aria-live="polite">尚未取得線索</span></div>
      </section>
      <aside class="side" aria-label="任務狀態">
        <section class="panel"><h2>任務進度 <span id="count" style="float:right;color:#1e8080">0 / 3</span></h2><div class="progressline"><div id="progress-bar"></div></div>
          <div class="step" id="step1"><span class="step-num">01</span><div><strong>理解對話</strong><small>接住情緒，而非爭辯</small></div><span class="digit" id="digit1">•</span></div>
          <div class="step" id="step2"><span class="step-num">02</span><div><strong>友善環境</strong><small>辨認生活中的安全線索</small></div><span class="digit" id="digit2">•</span></div>
          <div class="step" id="step3"><span class="step-num">03</span><div><strong>理解行為</strong><small>先看見行為背後的需求</small></div><span class="digit" id="digit3">•</span></div>
        </section>
        <section class="panel"><h2>遊戲規則</h2><div class="tipbox"><strong>每一關都有一個數字。</strong><br>蒐集三個數字後，按關卡順序輸入密碼即可完成逃脫。</div><p class="hint-text" style="margin-bottom:0">選錯可以再試，沒有失敗次數限制。每關可使用一次提示。</p></section>
      </aside>
    </main>
    <footer class="meta">本遊戲為衛生教育示範，案例與人物均屬虛構；強調以人為本、尊重差異的失智友善照護。實際照護須依個別狀況及專業評估調整。<br>參考資料：<a href="https://dementia.gov.taipei/cp.aspx?n=CE18E38199718FAF&s=C4544961CFCF1E45" target="_blank" rel="noopener">臺北市政府失智症服務網</a>、<a href="https://ihealth.vghtc.gov.tw/media/1162" target="_blank" rel="noopener">臺中榮民總醫院護理衛教</a>、<a href="https://ihealth.vghtpe.gov.tw/media/3758" target="_blank" rel="noopener">臺北榮總健康e點通</a>。</footer>
  </div>
  <div id="shade" class="shade" hidden><div id="dialog" class="dialog" role="dialog" aria-modal="true" aria-labelledby="dialog-title" tabindex="-1"></div></div>
  <script>
  (() => {
    'use strict';
    const state = {started:false,seconds:0,solved:[false,false,false],hints:[false,false,false],wrong:0,finished:false,active:null,sel2:new Set(),sel3:new Set()};
    const code = [4,7,2];
    let timerHandle=null, previouslyFocused=null;
    const $= id => document.getElementById(id);
    function clock(){ const m=String(Math.floor(state.seconds/60)).padStart(2,'0'),s=String(state.seconds%60).padStart(2,'0'); $('timer').textContent=`${m}:${s}`; }
    function begin(){ if(state.started) return; state.started=true; timerHandle=setInterval(()=>{ if(!state.finished){state.seconds++;clock();}},1000); }
    function esc(t){return String(t).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
    function frame(eyebrow,title,description,body,closable=true){
      $('dialog').innerHTML=`${closable?'<button class="close" id="close-dialog" aria-label="關閉視窗">×</button>':''}<div class="dialog-head"><div class="eyebrow">${eyebrow}</div><h2 id="dialog-title">${title}</h2><p>${description}</p></div><div class="dialog-body">${body}</div>`;
      if(closable) $('close-dialog').onclick=close;
      $('dialog').focus();
    }
    function show(closable=true){previouslyFocused=document.activeElement;$('shade').hidden=false;document.body.style.overflow='hidden'; $('dialog').dataset.closable=String(closable);}
    function close(){if($('dialog').dataset.closable==='false')return;$('shade').hidden=true;document.body.style.overflow='';state.active=null;previouslyFocused?.focus?.();}
    function feedback(text,type='warn'){const el=$('feedback');if(el){el.hidden=false;el.className='feedback '+type;el.textContent=text;el.setAttribute('role','status');}}
    function hint(i){if(state.hints[i-1]) return;state.hints[i-1]=true; $('hint-counter').textContent=`提示 ${state.hints.filter(Boolean).length} / 3`; const hints={1:'注意：對方的感受，比立即糾正時間或事實更值得先回應。',2:'找出能幫助辨識空間、減少跌倒風險，以及改善視線的三項作法。',3:'請從「身體需要、環境刺激、熟悉的支持」三個方向思考。'};feedback(hints[i],'success'); const btn=$('hint-btn');if(btn){btn.disabled=true;btn.textContent='已使用本關提示';}}
    function actionRow(i,label='提交答案') {return `<div class="dialog-actions"><button class="textbtn" id="hint-btn" ${state.hints[i-1]?'disabled':''}>${state.hints[i-1]?'已使用本關提示':'需要一點提示？'}</button><button class="btn" id="submit" ${i===1?'style="display:none"':''}>${label}</button></div><div id="feedback" class="feedback" hidden aria-live="polite"></div>`;}
    const puzzles = {
      1:{eyebrow:'第一關 · 溝通練習',title:'那張未寄出的明信片',desc:'桌上的對話卡，記錄著照護員今天遇到的情況。',intro:'阿芳女士反覆說：「我要回家，我爸爸在等我。」她看起來有些焦慮。你會先怎麼回應？',options:[
        ['A','「妳爸爸早就不在了，妳不要再說了。」'],['B','「您很想回家，我聽到了。我陪您坐一下，好嗎？」'],['C','「現在是活動時間，不要一直說要回家。」']
      ],correct:1,wrong:['直接糾正記憶可能加深不安。先傾聽與回應感受，再評估安全及需求。','', '只要求配合活動，可能忽略了她當下的情緒與需求。']},
      2:{eyebrow:'第二關 · 空間探索',title:'三個安全的改變',desc:'房間的環境清單裡，有六項不同的布置建議。',intro:'請從六張建議卡中，選出最適合優先改善失智友善活動室的三項作法。',options:[
        ['🚪','在洗手間門口設清楚、易辨識的標示'],['🧺','移走走道雜物及容易絆倒的小地毯'],['💡','增加適度照明，並減少眩光'],['🔒','把活動室所有出口從外面反鎖'],['🖼️','移除所有熟悉照片與個人物品'],['✨','在夜間走道使用持續閃爍的裝飾燈']
      ],correct:[0,1,2]},
      3:{eyebrow:'第三關 · 情境判斷',title:'黃昏時刻的線索',desc:'時鐘指向傍晚，模擬照護室傳來新的情境。',intro:'阿芳女士傍晚顯得焦躁、不停走動。沒有立即危險的跡象時，以下哪三項是適當的初步支持作法？',options:[
        ['💧','留意口渴、疼痛、如廁及其他不適'],['🌿','降低噪音，用平穩、簡短的語句陪伴'],['🎵','視其意願提供熟悉、喜歡的活動'],['📢','大聲責備她，要求立刻坐好'],['🧠','反覆考問日期，直到她答對'],['💊','未經評估，直接給予鎮靜藥物']
      ],correct:[0,1,2]}
    };
    function open(n){if(n<=3){if(n>1&&!state.solved[n-2])return;if(state.solved[n-1])return;begin();state.active=n;show();renderPuzzle(n);}else if(n===4){if(!state.solved.every(Boolean))return;state.active=4;show();renderFinal();}}
    function renderPuzzle(n){const d=puzzles[n];let body=`<div class="quote">${d.intro}</div>`;
      if(n===1){body+=`<div class="options">${d.options.map((opt,j)=>`<button class="option" data-choice="${j}"><span class="symbol">${opt[0]}</span><span>${opt[1]}</span></button>`).join('')}</div>`;}
      else{const sel=n===2?state.sel2:state.sel3;body+=`<p style="font-size:13px;margin:0;color:#54727b">已選 <strong id="selected-count">${sel.size}</strong> / 3 項</p><div class="grid-options">${d.options.map((opt,j)=>`<button class="option ${sel.has(j)?'selected':''}" data-choice="${j}" aria-pressed="${sel.has(j)}"><span class="symbol">${opt[0]}</span><span>${opt[1]}</span></button>`).join('')}</div>`;}
      body+=actionRow(n,n===1?'確認回答':'確認這三項');frame(d.eyebrow,d.title,d.desc,body);
      document.querySelectorAll('[data-choice]').forEach(btn=>btn.onclick=()=>pick(n,Number(btn.dataset.choice)));
      $('hint-btn').onclick=()=>hint(n); if(n>1) $('submit').onclick=()=>submit(n);
    }
    function pick(n,j){if(n===1){if(j===puzzles[n].correct){reward(n);}else{state.wrong++; feedback(puzzles[n].wrong[j]);const selected=document.querySelector(`[data-choice="${j}"]`);selected.classList.add('flash');setTimeout(()=>selected.classList.remove('flash'),550);}}else{
      const sel=n===2?state.sel2:state.sel3;
      if(sel.has(j))sel.delete(j);else if(sel.size<3)sel.add(j);else{feedback('一次選三項即可。若要更換，先取消一項已選擇的卡片。');return;}
      document.querySelectorAll('[data-choice]').forEach(b=>{const yes=sel.has(Number(b.dataset.choice));b.classList.toggle('selected',yes);b.setAttribute('aria-pressed',String(yes));});
      $('selected-count').textContent=sel.size;$('submit').disabled=sel.size!==3; $('feedback').hidden=true;
    }}
    function submit(n){const sel=n===2?state.sel2:state.sel3,correct=puzzles[n].correct;if(sel.size!==3)return;
      if([...sel].every(x=>correct.includes(x))){reward(n);}else{state.wrong++;feedback('還有更合適的做法。想想如何保有安全、尊嚴與自主，或先了解不安背後的需求。可更換選項再試。');}
    }
    function reward(n){state.solved[n-1]=true;update();const text={1:'先回應情緒、給予傾聽與陪伴，再依個別情況釐清需求與安全。',2:'清楚標示、安全走道與適當照明，能讓環境更容易辨識且降低意外風險。',3:'焦躁可能反映身體不適或環境壓力。先了解需求，採取溫和、個別化的支持。'};
      frame(`第 ${n} 關完成 · 取得密碼`, '你找到了一道友善照護線索', '衛教知識不只要答對，更重要的是理解背後的原則。', `<div class="reward"><small>本關密碼</small><b>${code[n-1]}</b><p>請記下這個數字，最後依關卡順序輸入。</p></div><div class="lesson">${text[n]}</div><div class="dialog-actions"><span style="color:#637e7a;font-size:13px">${n===3?'三個線索已全數蒐集。':'下一個場景物件已經解鎖。'}</span><button id="next-btn" class="btn">${n===3?'前往友善出口':'返回房間探索'}</button></div>`,false);
      $('next-btn').onclick=()=>{if(n===3){ $('dialog').dataset.closable='true';open(4); }else{ $('dialog').dataset.closable='true';close();}};
      $('dialog').dataset.closable='false';
    }
    function update(){const total=state.solved.filter(Boolean).length;$('count').textContent=`${total} / 3`;$('progress-bar').style.width=`${total*100/3}%`;$('room-status').textContent=total===0?'尚未取得線索':total===3?'密碼收集完成，請開啟出口':`已取得 ${total} / 3 組線索`;
      for(let i=1;i<=3;i++){$('step'+i).classList.toggle('done',state.solved[i-1]);$('digit'+i).textContent=state.solved[i-1]?code[i-1]:'•';const b=$('spot'+i);b.disabled= i>1&&!state.solved[i-2] || state.solved[i-1];b.classList.toggle('done',state.solved[i-1]); b.innerHTML=state.solved[i-1]?(i===1?'✓ 對話完成':i===2?'✓ 環境完成':'✓ 情境完成'):(i===1?'💬 對話卡片':i===2?'⌑ 環境清單'+(b.disabled?' 🔒':''):'◷ 黃昏時刻'+(b.disabled?' 🔒':''));}
      $('spot4').disabled=!state.solved.every(Boolean); }
    function renderFinal(){frame('最後關卡 · 密碼門','開啟友善之門','依第一、第二、第三關的順序，輸入你獲得的三個數字。', `<p>提示：數字都已記錄在右側「任務進度」。</p><label for="code-field" style="display:block;font-weight:850;margin-bottom:9px">三位數密碼</label><div class="codebox"><input id="code-field" type="text" autocomplete="off" inputmode="numeric" pattern="[0-9]*" maxlength="3" aria-describedby="code-help" placeholder="•••"><button class="btn" id="unlock">確認解鎖</button></div><p id="code-help" style="font-size:13px">密碼示例：123</p><div id="feedback" class="feedback" hidden aria-live="polite"></div>`);
      $('code-field').focus();$('code-field').addEventListener('input',e=>e.target.value=e.target.value.replace(/\D/g,'').slice(0,3));$('code-field').addEventListener('keydown',e=>{if(e.key==='Enter')unlock()});$('unlock').onclick=unlock;
    }
    function unlock(){const val=$('code-field').value;if(val===code.join('')){state.finished=true;clearInterval(timerHandle);complete();}else{state.wrong++;feedback('密碼不正確。依照第 1、2、3 關的順序，重新查看右側的數字。');}}
    function complete(){const mins=String(Math.floor(state.seconds/60)).padStart(2,'0'),sec=String(state.seconds%60).padStart(2,'0');frame('任務達成 · ESCAPED','你點亮了友善照護的一天！','這道出口象徵同理、環境支持與個別化照護，並不代表任何人被困在房間裡。', `<div class="hero-illustration" aria-hidden="true">🌤️</div><div class="summary"><div><b>${mins}:${sec}</b><span>完成時間</span></div><div><b>3 / 3</b><span>完成關卡</span></div><div><b>${state.wrong}</b><span>再次嘗試</span></div></div><h3>帶走三個關鍵觀念</h3><div class="lesson"><strong>01 理解對話：</strong>尊重感受，避免爭辯，給對方表達的時間。</div><div class="lesson"><strong>02 友善環境：</strong>清楚的指引、良好照明及安全動線，可以提供支持。</div><div class="lesson"><strong>03 理解行為：</strong>先觀察身體與環境需求，再選擇合適的支持措施。</div><p style="font-size:13px;margin-top:15px">小提醒：每位失智者狀況不同。若出現突然的意識、行為或身體狀況改變，應儘速尋求醫療評估。</p><div class="dialog-actions"><button class="btn light" id="close-win">返回房間</button><button class="btn" id="play-again">再玩一次</button></div>`,true);
      $('close-win').onclick=close;$('play-again').onclick=()=>location.reload();
    }
    function welcome(){show(false);state.active=0;frame('WELCOME · 失智友善教育遊戲','歡迎進入「記憶光房」','這是一間虛構的照護訓練教室，不會有真實人物被困住。', `<div class="welcome"><div class="hero-illustration" aria-hidden="true">🧩</div><h3>你的任務：找回安心與尊重</h3><p>阿芳女士是一位有失智症的社區居民。請透過三段模擬情境，練習如何與她溝通、打造適合的環境，以及理解可能的照護需求。</p><p><strong>玩法：</strong>點擊房內有標籤的物件，完成任務後取得密碼數字，最後開啟右側的友善出口。</p><button class="btn" id="start" style="width:100%;margin-top:8px">開始探索房間 →</button></div>`,false);$('start').onclick=()=>{$('dialog').dataset.closable='true';close();begin();};$('dialog').dataset.closable='false';}
    document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>open(Number(b.dataset.open))));
    $('restart').onclick=()=>{if(window.confirm('確定重新開始嗎？目前的任務進度將會清除。')) location.reload();};
    $('shade').addEventListener('click',e=>{if(e.target===$('shade'))close();});
    document.addEventListener('keydown',e=>{if(!$('shade').hidden){if(e.key==='Escape')close();if(e.key==='Tab') {const focusable=[...$('dialog').querySelectorAll('button:not([disabled]),input:not([disabled]),a[href]')].filter(el=>el.offsetParent!==null);if(focusable.length){const first=focusable[0],last=focusable[focusable.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}}}});
    update();welcome();
  })();
  </script>
</body>
</html>
